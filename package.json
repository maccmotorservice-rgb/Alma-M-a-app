{
  "name": "alma-mia-inventario",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "build:cloud": "esbuild scripts/supabase-entry.js --bundle --format=esm --platform=browser --outfile=assets/supabase-client.js --minify --legal-comments=linked",
    "build:pdf": "esbuild scripts/pdf-entry.js --bundle --format=esm --platform=browser --outfile=assets/pdf-client.js --minify --legal-comments=linked",
    "build:ocr": "node scripts/build-ocr.mjs",
    "build:zip": "esbuild scripts/zip-entry.js --bundle --format=esm --platform=browser --outfile=assets/zip-client.js --minify --legal-comments=linked && cp node_modules/fflate/LICENSE assets/zip-client.LICENSE.txt",
    "build:quote-reader": "node scripts/build-quote-reader.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tesseract.js-data/eng": "1.0.0",
    "fflate": "0.8.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
